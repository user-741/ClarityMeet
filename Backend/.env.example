# Copy this to .env and fill in your values. NEVER put real keys in this file -
# it is committed to git.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Zoom bot account
ZOOM_BOT_EMAIL=bot@example.com
ZOOM_BOT_PASSWORD=change-me

# Zoom webhook
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret

# Storage
DATA_DIR=./data

# Port (frontend uses 3000, backend 3001)
PORT=3001
